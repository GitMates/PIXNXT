ustifyContent: 'center', gap: '8px',\n                                      border: '2px dashed #cbd5e1', borderRadius: '10px', backgroundColor: '#f8fafc', cursor: 'pointer', color: '#94a3b8'\n                                    }}\n                                  >\n                                    <span style={{ fontSize: '24px' }}>\ud83d\uddbc\ufe0f</span>\n                                    <span style={{ fontSize: '12px', fontWeight: 600 }}>Add Desktop Image</span>\n                                    <span style={{ fontSize: '11px' }}>Recommended: 1600\u00d7400px</span>\n                                  </button>\n                                )}\n                              </div>\n\n                              {/* Mobile Image */}\n                              <div>\n                                <label style={{ display: 'block', fontSize: '11px', fontWeight: 600, color: '#475569', marginBottom: '8px', textTransform: 'uppercase', letterSpacing: '0.05em' }}>Mobile Background</label>\n                                {selectedAutomation.large_banner_mobile_image ? (\n                                  <div style={{ position: 'relative', borderRadius: '10px', overflow: 'hidden', border: '1px solid #e2e8f0', aspectRatio: '16/5' }}>\n                                    <img src={selectedAutomation.large_banner_mobile_image} alt=\"Mobile bg\" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />\n                                    <div style={{ position: 'absolute', inset: 0, background: 'rgba(0,0,0,0.35)', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '10px', opacity: 0, transition: 'opacity 0.2s' }}\n                                      onMouseEnter={e => e.currentTarget.style.opacity = 1}\n                                      onMouseLeave={e => e.currentTarget.style.opacity = 0}\n                                    >\n                                      <button onClick={() => { const u = prompt('Enter Mobile