{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:5173",
          "http://localhost:4173",
          "http://localhost:8899",
          "https://pixnxt.in",
          "https://www.pixnxt.in",
          "https://test.pixnxt.in",
          "https://pixnxt.pages.dev",
          "https://pixnxt-test.pages.dev"
        ],
        "methods": ["GET", "HEAD", "PUT", "POST"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Type"],
      "maxAgeSeconds": 3600
    }
  ]
}
