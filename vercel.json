{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/m/:slug/manifest.json", "destination": "/api/m/:slug/manifest" },
    { "source": "/m/:slug/icon-192.png", "destination": "/api/m/:slug/icon?size=192" },
    { "source": "/m/:slug/icon-512.png", "destination": "/api/m/:slug/icon?size=512" },
    { "source": "/m/:slug/apple-touch-icon.png", "destination": "/api/m/:slug/icon" },
    {
      "source": "/album-preview/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|linkedinbot|slackbot|telegrambot|discordbot|pinterest|embedly|redditbot|applebot|googlebot|bingbot|preview|iframely|vkshare|outbrain).*"
        }
      ],
      "destination": "/api/album-preview/:slug/og"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
