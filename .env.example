# Cloudflare-only backend (D1 + R2 + KV + Queues in ../backend).
# Frontend talks to it via VITE_API_URL + apiFetch (src/lib/api/client).
VITE_API_URL=http://localhost:8899
# Legacy flag, now ignored — the Workers API path is always on.
VITE_USE_WORKERS_API=1

# Public site URL for gallery share links, QR codes, and mobile gallery install emails.
# Must be your live custom domain (e.g. https://www.pixnxt.in).
VITE_PUBLIC_SITE_URL=https://www.pixnxt.in

# CNAME target for photographer custom domains (Settings → Branding → Custom Domain).
# Photographers create: gallery.theirdomain.com → CNAME → domain.pixnxt.in
# Add domain.pixnxt.in as a custom domain on your hosting project (Cloudflare Pages
# → Custom domains, CNAME to your Pages domain).
VITE_GALLERY_CNAME_TARGET=domain.pixnxt.in
VITE_PLATFORM_ROOT_DOMAIN=pixnxt.in
# Apex A records for root-domain setups. Must match pixnxt.in (currently 216.198.79.1).
# Never use Pixieset Cloudflare IPs (104.16.185.173 / 104.16.186.173).
VITE_GALLERY_APEX_IPS=216.198.79.1

# Google Drive — optional; "Save to Google Drive" in the gallery download modal
# Local download works for all visitors without Google.
#
# 1. https://console.cloud.google.com → APIs → enable "Google Drive API"
# 2. OAuth consent screen → User type: External
# 3. Credentials → OAuth client ID → Web application
#    Authorized JavaScript origins: http://localhost:5173 and your production URL
# 4. For ALL Google accounts (not just test users):
#    OAuth consent screen → Publish app → set Publishing status to "In production"
#    (Testing mode only allows emails listed under Test users — others get Error 403 access_denied)
# 5. drive.file scope may require Google verification after publishing; until then visitors
#    can still download via "Save to this device" (Local).
# 6. Paste the Client ID below, restart npm run dev
VITE_GOOGLE_CLIENT_ID=

# Server-only — Google OAuth client secret for studio login token exchange
# (server/googleAuthExchange.js via dev middleware / backend).
GOOGLE_CLIENT_SECRET=

# Google login (studio auth) — see docs/google-auth-setup.md
# Redirect URIs in Google Cloud:
#   http://localhost:5173/auth/google/callback
#   https://www.pixnxt.in/auth/google/callback
# Use the same Client ID + secret as above.

# AWS Rekognition — server-side only (hosting env + local .env, no VITE_ prefix)
# Attach docs/aws-rekognition-iam-policy.json to IAM user `rekognition-user`
# (see docs/aws-rekognition-setup.md). AWS still names the API “Collection”;
# PIXNXT uses one face group per delivery.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Crash report (Cloudflare Analytics Engine via Worker in workers/crash-reporter)
# Frontend: set to your deployed Worker URL after `wrangler deploy`. Admin page
# /admin/crashes reads from the same URL. Leave empty = taxonomy preview + offline queue.
VITE_CRASH_WORKER_URL=
# Server-only fallback for crash-report forwarding (hosting env, no VITE_ prefix)
# CRASH_WORKER_URL=
